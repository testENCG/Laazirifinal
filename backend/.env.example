# Database Configuration
DATABASE_URL=sqlite:///laazari.db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Environment
FLASK_ENV=development
DEBUG=False

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Configuration (Gmail)
# 1. Activer la verification en 2 etapes sur votre compte Google
# 2. Aller sur: https://myaccount.google.com/apppasswords
# 3. Creer un mot de passe d'application
# 4. Coller le mot de passe ci-dessous (sans espaces)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=laaziritravel@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application-ici
